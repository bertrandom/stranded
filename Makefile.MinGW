
CFLAGS=-I/include/ -Wall --std=c99

LDFLAGS=-L/lib/ -mwindows

LDLIBS=-lmingw32 -lSDL2main -lSDL2

EXE =   stranded

OBJ =   jc_reborn.o \
        utils.o \
        uncompress.o \
        resource.o \
        dump.o \
        story.o \
        walk.o \
        calcpath.o \
        ads.o \
        ttm.o \
        island.o \
        bench.o \
        graphics.o \
        sound.o \
        events.o \
        config.o \
        night.o \
        web.o


all: $(EXE)

$(EXE): $(OBJ)
	$(CC) $(LDFLAGS) $(OBJ) $(LDLIBS) -o $@

clean:
	rm -v $(OBJ) $(EXE) 2> /dev/null ; true

