
CFLAGS=-Wall -Wpedantic -std=c99 -I$(shell pkg-config --variable=includedir sdl2) $(shell pkg-config --cflags sdl2)

LDLIBS=$(shell pkg-config --libs sdl2)

# libdrm is used to power the monitor off in night mode
ifeq ($(shell pkg-config --exists libdrm && echo yes),yes)
CFLAGS += -DHAVE_LIBDRM $(shell pkg-config --cflags libdrm)
LDLIBS += $(shell pkg-config --libs libdrm)
endif

# The git revision, shown on the web page. revision.txt is only rewritten
# when it changes, so that web.o is rebuilt then and only then
GIT_REVISION := $(shell git describe --always --dirty 2>/dev/null || echo unknown)
$(shell echo $(GIT_REVISION) | cmp -s - revision.txt || echo $(GIT_REVISION) > revision.txt)

EXE =   stranded

OBJ =   jc_reborn.o \
        utils.o \
        uncompress.o \
        resource.o \
        dump.o \
        story.o \
        walk.o \
        calcpath.o \
        ads.o \
        ttm.o \
        island.o \
        bench.o \
        graphics.o \
        sound.o \
        events.o \
        config.o \
        night.o \
        web.o


all: $(EXE)

$(EXE): $(OBJ)
	$(CC) $(LDFLAGS) $(OBJ) $(LDLIBS) -o $@

web.o: CFLAGS += -DGIT_REVISION='"$(GIT_REVISION)"'
web.o: revision.txt

clean:
	rm -v $(OBJ) $(EXE) revision.txt 2> /dev/null ; true

