
CFLAGS=-Wall -Wpedantic -std=c99 -I$(shell pkg-config --variable=includedir sdl2) $(shell pkg-config --cflags sdl2)

LDLIBS=$(shell pkg-config --libs sdl2)

# libdrm is used to power the monitor off in night mode
ifeq ($(shell pkg-config --exists libdrm && echo yes),yes)
CFLAGS += -DHAVE_LIBDRM $(shell pkg-config --cflags libdrm)
LDLIBS += $(shell pkg-config --libs libdrm)
endif

EXE =   jc_reborn

OBJ =   jc_reborn.o \
        utils.o \
        uncompress.o \
        resource.o \
        dump.o \
        story.o \
        walk.o \
        calcpath.o \
        ads.o \
        ttm.o \
        island.o \
        bench.o \
        graphics.o \
        sound.o \
        events.o \
        config.o \
        night.o \
        web.o


all: $(EXE)

$(EXE): $(OBJ)

clean:
	rm -v $(OBJ) $(EXE) 2> /dev/null ; true

