#!/bin/sh
# Checks for, or installs, the latest release of stranded from GitHub
#
#   stranded-update check     prints the installed and latest versions, as JSON
#   stranded-update install   installs the latest release if it's newer (as root)
#
# The web page runs "check" itself, and "install" through
# stranded-update.service, which polkit lets the stranded user start
set -eu

REPO=bertrandom/stranded
ARCH=$(dpkg --print-architecture)

# Sets $latest (eg. 2026.10.29) and $url, the release's .deb for this
# architecture. GitHub's JSON has one property per line
latest_release() {
    json=$(curl -fsS --max-time 20 "https://api.github.com/repos/$REPO/releases/latest")
    tag=$(printf '%s\n' "$json" | sed -n 's/^ *"tag_name": *"\([^"]*\)".*/\1/p' | head -n 1)
    url=$(printf '%s\n' "$json" | sed -n "s/^ *\"browser_download_url\": *\"\([^\"]*_$ARCH\.deb\)\".*/\1/p" | head -n 1)
    latest=${tag#v}

    if [ -z "$latest" ] || [ -z "$url" ]; then
        echo "No $ARCH package in the latest release of $REPO" >&2
        exit 1
    fi
}

installed=$(dpkg-query -W -f '${Version}' stranded)

case "${1:-}" in

    check)
        latest_release
        available=false
        dpkg --compare-versions "$latest" gt "$installed" && available=true
        # A oneshot service is "activating" while it runs
        updating=false
        case "$(systemctl is-active stranded-update.service || true)" in
            active|activating) updating=true ;;
        esac
        printf '{"installed": "%s", "latest": "%s", "updateAvailable": %s, "updating": %s}\n' \
            "$installed" "$latest" "$available" "$updating"
        ;;

    install)
        latest_release

        if dpkg --compare-versions "$latest" le "$installed"; then
            echo "Already up to date: $installed"
            exit 0
        fi

        tmp=$(mktemp -d)
        trap 'rm -rf "$tmp"' EXIT
        deb=$tmp/$(basename "$url")

        echo "Updating from $installed to $latest"
        curl -fsSL --max-time 300 -o "$deb" "$url"
        apt-get update -qq || true    # in case it needs new dependencies
        DEBIAN_FRONTEND=noninteractive apt-get install -y "$deb"
        echo "Updated to $latest"
        ;;

    *)
        echo "Usage: $0 check|install" >&2
        exit 2
        ;;
esac
